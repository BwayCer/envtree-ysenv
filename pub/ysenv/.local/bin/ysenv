#!/bin/env python3

from typing import Callable
from enum import Enum, auto
import hashlib
import os
import random
import subprocess
import sys
import yaml


def pathJoin(root: str, *args: tuple[str, ...]) -> str:
    '把路徑依平台分隔符重新組合.'
    pathParts = []
    for thePath in args:
        for part in thePath.split('/'):
            pathParts.append(part)
    return os.path.normpath(os.path.join(root, *pathParts))


helpTxt = '''\
環境設定文件解析器
Usage:
    edit
    list <pallet|host|cntr>
    host <實例>
    cntr <實例> [... docker opt]
Opt:
  -h, --help   幫助.
'''

_fileDir = os.path.dirname(os.path.abspath(__file__))
_filename = os.path.basename(__file__)

_origArgv = sys.argv

__hostHome = os.environ['HOME']
__pwd = os.environ['PWD']

__viCommand = 'vi'
__cntrCommand = 'podman' # 'docker'

__baseErrMsg = '環境設定文件不正確.'
__argvErrMsg = '參數設定不正確.'

__forklift = 'forklift'
__fieldOfString = {'name', 'image', 'vmhome', 'workdir'}
__fieldOfBoolean = {'daemon'}
__fieldOfArray = {'volume', 'rc'}
__allowArgvOverwriteField = __fieldOfString ^ __fieldOfBoolean

__vmNameFormat = 'V{RAND}-vm'
__randList26 = 'abcdefghijklmnopqrstuvxwyz'


def main():
    envConfigPath = pathJoin(_fileDir, './config.yaml')

    action, groups, instance, cntrOptStratIndex = __parseCmdArgv(_origArgv)

    if action == Action.HELP or action == Action.NEEDHELP:
        sysPrintExit(0 if action == 'Help' else 1, helpTxt)

    if action == Action.EDIT:
        confirmAndExec(f'{__viCommand} {envConfigPath!r}')
    elif not os.path.exists(envConfigPath):
        sysPrintExit(1, f'請先 `{_filename} edit` 編輯環境設定文件.')

    exitCode, envConfig = loadConfig(envConfigPath)
    if exitCode != 0:
        sysPrintExit(exitCode, envConfig)

    palletBoxsByForklift, argvGroup, carryOpt, carryCmd \
        = __parseCmdArgvForCarryOpt(_origArgv, cntrOptStratIndex)
    exitCode, txt = __matchProcess(
        envConfig,
        action, groups, instance,
        palletBoxsByForklift, argvGroup, carryOpt, carryCmd,
    )

    if exitCode != 0 or action == Action.LIST:
        sysPrintExit(exitCode, txt)
    else:
        confirmAndExec(txt)


class Action(Enum):
    HELP = auto()
    NEEDHELP = auto()
    EDIT = auto()
    LIST = auto()
    HOST = auto()
    CNTR = auto()


def __parseCmdArgv(argv: tuple[str, ...]) -> tuple[Action, str, str, int]:
    isNeedHelp = True
    action = Action.HELP
    groups = ''
    instance = ''
    nextIdx = 1

    argv_ = argv
    if '--' in argv:
        argv_ = argv[:argv.index('--')]

    argvLength = len(argv_)
    if '-h' in argv_ or '--help' in argv_:
        isNeedHelp = False
        action = Action.HELP
    elif argvLength == 2 and argv_[1] == 'edit':
        nextIdx += 1
        isNeedHelp = False
        action = Action.EDIT
    elif argvLength > 2:
        isListSubCmd = False
        isHasInstance = False
        if argv_[1] == 'list':
            isListSubCmd = True
            nextIdx += 1

        if argvLength > nextIdx + 1:
            instance_ = argv_[nextIdx + 1]
            if not (instance_ == '' or instance_.startswith('-')):
                isHasInstance = True

        groups_ = argv_[nextIdx]
        match groups_:
            case 'pallet' if isListSubCmd:
                isNeedHelp = False
                nextIdx += 1
                action = Action.LIST
                groups = 'palletBoxs'

            case 'host' | 'cntr' if isListSubCmd or isHasInstance:
                isNeedHelp = False
                nextIdx += 1
                action = (
                    Action.LIST if isListSubCmd
                    else Action.HOST if groups_ == 'host'
                    else Action.CNTR
                )
                groups = groups_ + 's'

                if isHasInstance:
                    nextIdx += 1
                    instance = instance_

    if isNeedHelp:
        action = Action.NEEDHELP

    return action, groups, instance, nextIdx


def __parseCmdArgvForCarryOpt(
    argv: tuple[str, ...],
    startIdx: int,
) -> tuple[list, dict, list, list]:
    idx = startIdx
    length = len(argv)

    palletBoxsByForklift = []
    argvGroup = {}
    carryOpt = []
    carryCmd = []
    while idx < length:
        item = argv[idx]
        if item == '--':
            carryCmd += argv[idx + 1:length]
            break
        elif item.startswith('-'):
            isHasValue = False
            value = True
            if idx + 1 < length and not argv[idx + 1].startswith('-'):
                isHasValue = True
                idx += 1
                value = argv[idx]

            itemKey = item[2:] if item.startswith('--') else item
            if itemKey == __forklift:
                palletBoxsByForklift.append(value)
            elif itemKey in __allowArgvOverwriteField:
                argvGroup[itemKey] = value
            elif isHasValue:
                carryOpt += [item, value]
            else:
                carryOpt.append(item)

            idx += 1
        else:
            carryCmd += argv[idx:length]
            break

    return palletBoxsByForklift, argvGroup, carryOpt, carryCmd


def loadConfig(filePath: str) -> tuple[int, str]:
    '載入環境設定文件.'
    try:
        with open(filePath, 'r', encoding='utf-8') as fs:
            data = yaml.load(fs, Loader=yaml.SafeLoader)
        return 0, data

    except Exception as err:
        return 1, err


def __matchProcess(
    envConfig: dict,
    action: Action,
    groupListName: str,
    instanceName: str,
    palletBoxsByForklift: list,
    argvGroup: dict,
    carryOpt: list,
    carryCmd: list,
) -> tuple[int, str]:
    errMsg = __checkEnvConfigXxBase(envConfig)
    if errMsg is not None:
        return 1, errMsg

    groups = envConfig[groupListName]
    groupsKeys = groups.keys()

    # instanceName 為空值, 則 action 必為 List
    if instanceName == '':
        return 0, ' '.join(groupsKeys)
    elif instanceName not in groups:
        return (
            1,
            f'找不到 "{instanceName}" 實例. (允許值: {", ".join(groupsKeys)})'
        )

    # `os.path.expanduser()` 只接受 `~` 無法辨別 `$HOME`.
    ysPath = os.path.expanduser(envConfig['ysPath'])

    instanceId = f'{groupListName}.{instanceName}'
    exitCode, info = __getGroupDetails(
        ysPath, envConfig, groupListName, instanceName, palletBoxsByForklift, argvGroup,
    )
    if exitCode != 0:
        return 1, info

    match action:
        case Action.LIST:
            handler = __listGroupDetails
        case Action.HOST:
            handler = __listHostCmd
        case Action.CNTR:
            handler = __listCntrRunCmd

    return handler(instanceId, ysPath, info, carryOpt, carryCmd)


def __checkEnvConfigXxBase(envConfig: dict) -> [None | str]:
    level01Type = {
        'ysPath': str,
        'palletBoxs': dict,
        'hosts': dict,
        'cntrs': dict,
    }
    for key, val in level01Type.items():
        if key not in envConfig or not isinstance(envConfig[key], val):
            return f'{__baseErrMsg} ("{key}" 欄位遺失或格式錯誤)'


def __checkEnvConfigXxMergePalletBoxs(
    instanceId: str,
    mergeItems: object,
    allowList: list,
) -> [None | str]:
    if not isinstance(mergeItems, list):
        return f'({instanceId} 的 "groups" 欄位格式必須為 `Array`.)'

    allowList = set(allowList)
    mergeItems = set(mergeItems)

    # 怕有 None 而出錯
    notExistGroups = list(map(str, mergeItems - allowList))
    if len(notExistGroups) > 0:
        return (
            f'("{instanceId}" 有不存在的 "{'", "'.join(notExistGroups)}" 群組)'
        )


def __getGroupDetails(
    ysPath: str,
    envConfig: dict,
    instanceListName: str,
    instanceName: str,
    palletBoxsByForklift: list,
    argvGroup: dict,
) -> tuple[int, [str | dict]]:
    palletBoxs = envConfig['palletBoxs']
    instance = envConfig[instanceListName][instanceName]
    instanceId = f'{instanceListName}.{instanceName}'

    if not isinstance(instance, dict):
        return 1, f'找不到 "{instanceId}" 實例. (未設定選項)'

    allowPalletBoxs = palletBoxs.keys()
    palletBoxsByForkliftSet = set(palletBoxsByForklift)
    pickPalletBoxs = []

    if 'palletBoxs' in instance:
        palletBoxsByInstance = instance['palletBoxs']
        errMsg = __checkEnvConfigXxMergePalletBoxs(
            instanceId, palletBoxsByInstance, allowPalletBoxs,
        )
        if errMsg is not None:
            return 1, f'{__baseErrMsg} {errMsg}'
        pickPalletBoxs += [
            item for item in palletBoxsByInstance
            if item not in palletBoxsByForkliftSet
        ]

    if len(palletBoxsByForklift) > 0:
        errMsg = __checkEnvConfigXxMergePalletBoxs(
            f'--{__forklift}', palletBoxsByForklift, allowPalletBoxs,
        )
        if errMsg is not None:
            return 1, f'{__argvErrMsg} {errMsg}'
        pickPalletBoxs += [item for item in palletBoxsByForklift]

    mergeItems = [
        [f'palletBoxs.{item}', palletBoxs[item]]
        for item in pickPalletBoxs
    ] + [['instance', instance], ['argv', argvGroup]]

    newInfo = {}
    for item in mergeItems:
        theId = item[0]
        theInfo = item[1]

        if not isinstance(theInfo, dict):
            return 1, f'{__baseErrMsg} ({instanceId} 的 {theId} 的格式錯誤)'

        errMsg = __mergeGroup(newInfo, theId, theInfo)
        if errMsg is not None:
            return 1, f'{__baseErrMsg} ({instanceId} 的 {errMsg})'

    vmHome = ''
    if instanceListName == 'cntrs':
        if 'image' not in newInfo:
            return 1, f'{__baseErrMsg} ({instanceId} 找不到指定映像文件)'

        # 在 cntrs 的 instance 中設定 `vmhome` 欄位.
        if 'vmhome' not in newInfo:
            vmHome = __getCntrContainerHomePath(
                newInfo['image']['value'],
                user=newInfo['user']['value'] if 'user' in newInfo else None,
            )
            newInfo['vmhome'] = {'value': vmHome, 'from': 'via container'}

        cwdDir = __pwd + os.path.sep
        ysDir = ysPath + os.path.sep
        if 'workdir' not in newInfo and cwdDir.startswith(ysDir):
            newInfo['workdir'] = {'value': __pwd, 'from': 'default'}

        # 如果有 `name` 欄位則會自動產生或覆寫 `hostname` 欄位.
        if 'name' in newInfo:
            newInfo['hostname'] = newInfo['name']

    elif instanceListName == 'hosts':
        if not ('volume' in newInfo or 'rc' in newInfo):
            return (
                1,
                f'{__baseErrMsg} ({instanceId} 是空白任務 (沒有 `volume`, `rc`))'
            )

    errMsg = __mergeVolume(newInfo, vmHome)
    if errMsg is not None:
        return 1, f'{__baseErrMsg} ({instanceId} 的 {errMsg})'

    return 0, newInfo


def __isList(obj: object) -> bool:
    return isinstance(obj, list)


def __mergeGroup(info: dict, srcId: str, src: dict) -> [None | str]:
    errMsg = '"{}" 欄位格式必須為 `{}`'
    skipList = {'palletBoxs'}
    for key, val in src.items():
        if key in skipList:
            pass
        elif key in __fieldOfString:
            val = str(val)
            info[key] = {'value': f'{val}', 'from': srcId}
            if val.strip() == '':
                return f'"{key}" 欄位不得為空值.'
        elif key in __fieldOfBoolean:
            if isinstance(val, bool):
                info[key] = {'value': val, 'from': srcId}
            else:
                return errMsg.format(key, 'Boolean')
        elif key in __fieldOfArray:
            if __isList(val):
                pushValue = [
                    {'value': value, 'from': srcId}
                    for value in val if value is not None
                ]
                if key in info:
                    info[key] += pushValue
                else:
                    info[key] = pushValue
            else:
                return errMsg.format(key, 'Array')
        else:
            keyType = type(val)
            if key in info and keyType is not type(info[key].value):
                return f'"{key}" 欄位前後格式不一'

            if __isList(val) and key in info and __isList(info[key]):
                pushValue = [{'value': value, 'from': srcId} for value in val]
                info[key] += pushValue
            else:
                info[key] = {'value': val, 'from': srcId}


def __mergeVolume(info: dict, vmHome: str = '') -> [None | str]:
    if 'volume' not in info:
        return

    # `vmHome + '/'` 解決 `os.path.normpath()` 不處理 `//` 出現在首字母的問題.
    vmHome = __hostHome if vmHome == '' else (vmHome + '/')
    volumeList = info['volume'].copy()

    for item in volumeList:
        value = item['value']
        fromGroup = item['from']

        splitValueList = value.split(':')
        splitValueListLength = len(splitValueList)
        if splitValueListLength < 2:
            return f'{fromGroup} 的 {value!r} 格式錯誤'

        hostPath = splitValueList[0]
        vmPath = splitValueList[1]

        if hostPath.startswith('~/'):
            hostPath = hostPath.replace('~', __hostHome, 1)
        if vmPath.startswith('~/'):
            vmPath = vmPath.replace('~', vmHome, 1)

        item['hostPath'] = os.path.normpath(hostPath)
        item['vmPath'] = os.path.normpath(vmPath)
        item['permission'] \
            = splitValueList[2] if splitValueListLength == 3 else ''

    # 排除相同路徑, 父目錄路徑, 後面覆蓋前面
    pickPaths = []
    newVolumeList = []
    for item in sorted(volumeList[::-1], key=__sortVolumeKey, reverse=True):
        vmPath = item['vmPath']

        isContinue = False
        for refItem in pickPaths:
            if vmPath == refItem or refItem.startswith(vmPath + '/'):
                isContinue = True
                break
        if isContinue:
            continue

        pickPaths.append(vmPath)
        newVolumeList.append(item)

    info['volume'] = newVolumeList[::-1]


def __sortVolumeKey(item: dict) -> int:
    return len(item['vmPath'])


def __getCntrContainerHomePath(
    image: str,
    user: [None | str],
) -> dict:
    '''
    取得容器內家目錄路徑.

    `--rm` 會使 `docker run` 退出時花一段時間，具體秒數約 0~6 秒不等
    '''

    cmdList = [__cntrCommand, 'run', '--rm']

    if user is not None:
        cmdList += ['--user', user]

    cmdList += [image, 'sh', '-c', 'echo $HOME']

    # `capture_output=True`:
    #   相當於同時設定了 `stdout=subprocess.PIPE` 和
    #   `stderr=subprocess.PIPE` 用於捕獲命令的標準輸出和標準錯誤, 並通过
    #   `result.stdout` 和 `result.stderr` 屬性訪問.
    # `text=True`:  (或 universal_newlines=True)
    #   將原本捕獲的位元 (bytes) 格式標準輸出解碼為字串.
    result = subprocess.run(cmdList, capture_output=True, text=True)
    containerHome = result.stdout.strip()

    return containerHome


def __getRcTxt(
    rcInfo: list, isPersist: bool = False
) -> tuple[str, str, Callable[[], None]]:
    nodePath = __hostHome if isPersist else '/tmp'

    rcLines = [item['value'] for item in rcInfo]
    rcTxt = '\n'.join(rcLines)
    hashCode = hashlib.sha256(rcTxt.encode()).hexdigest()[:7]

    rcFileName = f'.bashrc_ysenv_{hashCode}'
    rcFilePath = f'{nodePath}/{rcFileName}'

    def createRcTxt():
        if not os.path.exists(rcFilePath):
            with open(rcFilePath, 'w', encoding='utf-8') as fs:
                fs.write(rcTxt)

    return rcFileName, rcFilePath, createRcTxt


def __listGroupDetails(
    instanceId: str,
    ysPath: str,
    info: dict,
    carryOpt: list,
    carryCmd: list,
) -> tuple[int, str]:
    skipList = {'image', 'vmhome', 'workdir', 'daemon', 'volume', 'rc'}
    isCntr = instanceId.startswith('cntrs.')

    showMsgs = [f'ysPath : {ysPath}']

    if isCntr:
        showMsgs += [
            f'{key:7s}: {info[key]['value'] or '(empty)'}   (by {info[key]['from']})'
            for key in ['vmhome', 'workdir']
        ] + [
            f'{key}: {info[key]['value'] or '(empty)'}   (by {info[key]['from']})'
            for key in ['image']
        ]

        if len(carryOpt):
            showMsgs += \
                ['carryOpt: ' + ' '.join([f'{item!r}' for item in carryOpt])]
        if len(carryCmd):
            showMsgs += \
                ['carryCmd: ' + ' '.join([f'{item!r}' for item in carryCmd])]

        showMsgs += ['']

    if isCntr:
        showMsgs += ['Set option:']

        showMsgs += [
            '  --rm   (by default)'
            if 'daemon' not in info or info['daemon']['value'] is not True
            else f'  #NotRmFlag   (by {info['daemon']['from']})'
        ]

        if '-it' not in carryOpt:
            showMsgs += ['  -it   (by default)']

        for key, val in info.items():
            if key in skipList:
                continue

            if isinstance(val, list):
                showMsgs += [
                    f'  --{key} = {subVal['value']}   (by {subVal['from']})'
                    for subVal in val
                ]
            else:
                value = val['value']
                fromGroup = val['from']
                showMsgs += [
                    f'  --{key}'
                    + ('' if isinstance(value, bool) else f' = {value}')
                    + f'   (by {fromGroup})'
                ]

        showMsgs += ['']

    if 'volume' in info:
        volumeInfo = info['volume']

        showMsgs += ['Volume list:']
        maxLetterLength = sorted(map(__sortVolumeKey, volumeInfo))[-1]
        for item in volumeInfo:
            hostPath = item['hostPath']
            vmPath = item['vmPath']
            # permission = item['permission']
            fromGroup = item['from']
            showMsgs += [
                f'  {vmPath:<{maxLetterLength}s}'
                f' --> {hostPath}   (by {fromGroup})'
            ]

        showMsgs += ['']

    if 'rc' in info:
        rcInfo = info['rc']

        showMsgs += ['rc file:']
        currFromGroup = ''
        for item in rcInfo:
            cmd = item['value']
            fromGroup = item['from']
            if currFromGroup != fromGroup:
                currFromGroup = fromGroup
                showMsgs += [f'  (by {fromGroup})']
            showMsgs += [f'    {cmd}']

        showMsgs += ['']

    return 0, '\n'.join(showMsgs)


def __listHostCmd(
    instanceId: str,
    ysPath: str,
    info: dict,
    carryOpt: list,
    carryCmd: list,
) -> tuple[int, str]:
    exitCode = 0
    cmdLines = []
    warnLines = []

    if 'volume' in info:
        newCreateDir = []
        for item in info['volume']:
            hostPath = item['hostPath']
            vmPath = item['vmPath']

            if os.path.exists(vmPath):
                if hostPath == vmPath:
                    continue

                if not os.path.islink(vmPath):
                    exitCode = 1
                    warnLines += [f'echo "請刪除 {vmPath!r} 文件路徑"']
                    continue

            vmDir = os.path.dirname(vmPath)
            if not os.path.exists(vmDir) and vmDir not in newCreateDir:
                cmdLines += [f'mkdir -p {vmDir!r}']
                newCreateDir.append(vmDir)

            cmdLines += [f'ln -sfn {hostPath!r} {vmPath!r}']

    isHasRcField = 'rc' in info
    if isHasRcField:
        rcFileName, rcFilePath, createRcTxt = __getRcTxt(info['rc'], True)

    tmpFileNames = os.listdir(__hostHome)
    for tmpFileName in tmpFileNames:
        if not tmpFileName.startswith('.bashrc_ysenv_'):
            continue

        if isHasRcField and tmpFileName == rcFileName:
            continue

        exitCode = 1
        warnLines += [f'echo "請執行 \\`rm {__hostHome}/{tmpFileName}\\`"']

    if exitCode == 0 and isHasRcField:
        createRcTxt()
        cmdLines += [f'echo "請執行 \\`source {rcFilePath!r}\\`"']

    # 因為警告也是以 bash 輸出, 使用標準輸出才能配合 `sh <(...)`
    return 0, '\n'.join(
        cmdLines if exitCode == 0 else warnLines
    )


def __listCntrRunCmd(
    instanceId: str,
    ysPath: str,
    info: dict,
    carryOpt: list,
    carryCmd: list,
) -> tuple[int, str]:
    cmdList = [__cntrCommand, 'run']
    skipList = {'image', 'vmhome', 'daemon', 'volume', 'rc'}
    image = info['image']['value']

    if (
        ('daemon' not in info or info['daemon']['value'] is not True)
        and '--rm' not in carryOpt
    ):
        cmdList += ['--rm']

    if '-it' not in carryOpt:
        cmdList += ['-it']

    # 自動設定 `name`, `hostname`
    vmName = __vmNameFormat.replace(
        '{RAND}', ''.join(random.choices(__randList26, k=6)),
    )
    if 'name' not in info:
        cmdList += ['--name', vmName]
    if 'hostname' not in info:
        cmdList += ['--hostname', vmName]

    for key, val in info.items():
        if key in skipList:
            continue

        if isinstance(val, list):
            for subVal in val:
                cmdList += [f'--{key}', __printValue(subVal['value'])]
        else:
            cmdList += [f'--{key}']
            value = val['value']
            if not isinstance(value, bool):
                cmdList += [__printValue(value)]

    volumeList = __getCntrRunVolumeList(ysPath, info)
    for item in volumeList:
        cmdList += ['--volume', __printValue(item)]

    cmdList += [__printValue(val) for val in carryOpt]

    cmdList += [image]

    if len(carryCmd) > 0:
        cmdList += carryCmd

    return 0, ' '.join(cmdList)

def __printValue(value: str):
    if ' ' in value:
        return '{!r}'.format(value)
    else:
        return value


def __getCntrRunVolumeList(ysPath: str, info: dict) -> list[str]:
    vmHome = info['vmhome']['value']
    volumeList = []

    if 'volume' in info:
        for item in info['volume']:
            volumeOpt = f'{item['hostPath']}:{item['vmPath']}'
            permission = item['permission']
            if permission != '':
                volumeOpt += f':{permission}'
            volumeList += [volumeOpt]

    if 'rc' in info:
        rcFileName, rcFilePath, createRcTxt = __getRcTxt(info['rc'])
        createRcTxt()
        volumeList += [f'{rcFilePath}:{vmHome}/{rcFileName}']

    volumeList += [f'{ysPath}:{ysPath}']

    ysRealPath = os.path.realpath(ysPath)
    if ysPath != ysRealPath:
        volumeList += [f'{ysRealPath}:{ysRealPath}']

    return volumeList


def sysPrintExit(exitCode: int, txt: str):
    print(txt, file=None if exitCode == 0 else sys.stderr)
    exit(exitCode)


def confirmAndExec(txt: str):
    print("Shell Run:")
    print(f"{txt}\n")

    try:
        choice = input('是否執行腳本？[y/N]: ').strip().lower()
    except (KeyboardInterrupt, EOFError):
        # ex: `Ctrl + C`, `kill -2 <PID>`
        exit(130)

    if choice in ['y', 'yes']:
        try:
            os.execvp('sh', ['sh', '-c', txt])
        except Exception as e:
            sysPrintExit(1, f"執行失敗: {e}")

    exit(0)


if __name__ == '__main__':
    main()
