#!/bin/env bash
# 命令行提示

# NOTE:
# 1. 無法使用 `history` 命令
# 2. 不加 `export` 可以讓同層的 shell 取的到變量，但其子層則無值
#    export PS777_hasTime=0
# 3. https://askubuntu.com/questions/372849
#    PS1="${debian_chroot:+($debian_chroot)}"


PS777() {
  local ps1_u="$1"
  local ps1_h="$2"
  local ps1_w="$3"
  local exitCode=$4

  # NOTE:
  # 很久前保留的一段描述
  #     We have color support; assume it's compliant with Ecma-48
  #     (ISO/IEC-6429). (Lack of such support is extremely rare, and such
  #     a case would tend to support setf rather than setaf.)
  # 以及所使用的判斷方式
  #     [ -x /usr/bin/tput ] && tput setaf 1 &> /dev/null && { ... } || :
  # 但在使用 "apline:3.11.5" 的容器時發現
  # 其沒有安裝 `tput` 也可以正常顯示 "\[\033[31;01m\]" 等顏色表示式
  # 故決定在 PS1 上一律顯示顏色

  # "\[\033[31;01m\]" (PS1 適用)
  local _fN="\033[00m"
  local _fRedB="\033[31;01m"
  local _fGreB="\033[32;01m"
  local _fYelB="\033[33;01m"
  local _fCyaB="\033[36;01m"
  local _fCyaW="\033[37;01m"

  local showWorkdir="$ps1_w"
  # $COLUMNS == `tput cols`
  local diffSize=$((${#showWorkdir} - (COLUMNS * 3 / 7)))

  local showWorkdirStart=""
  local showWorkdirMiddle=""
  PS777_fnAutoPathSize() {
    local idx len

    # 將路徑分割成各個目錄
    local pathParts
    IFS='/' read -ra pathParts <<< "$showWorkdir"

    ## 以忽略符顯示: 目錄數*4 仍大於終端顯示寬的一半
    [ $((${#showWorkdir} - ${#pathParts[-1]} - (${#pathParts[@]} - 1) * 4)) \
      -ge $diffSize \
    ] || {
      showWorkdirStart="${pathParts[0]}/${pathParts[1]}/";
      showWorkdirMiddle="...";
      showWorkdir="/${pathParts[-1]}";
      return;
    }

    ## 以略縮目錄 `xxx>` 顯示
    # 前兩個目錄和最後一個目錄是固定的
    showWorkdirStart="${pathParts[0]}/${pathParts[1]}/"
    showWorkdir=""
    for ((idx=2, len=(${#pathParts[@]} - 1); idx < len; idx++)); do
      if [ $diffSize -gt 0 ]; then
        if [ ${#pathParts[idx]} -gt 3 ]; then
          ((diffSize-= ${#pathParts[idx]} - 4))
          showWorkdirMiddle+="${pathParts[idx]:0:3}>"
        else
          showWorkdirMiddle+="${pathParts[idx]}/"
        fi
      else
        showWorkdir+="${pathParts[idx]}/"
      fi
    done
    showWorkdir+="${pathParts[-1]}"
  }

  ## 原路徑顯示: 路徑長度小於終端顯示寬的一半
  if [ $diffSize -le 0 ]; then
    printf "${_fGreB}%s@%s${_fN}:${_fCyaB}%s${_fN}" "$ps1_u" "$ps1_h" "$ps1_w"
  else
    PS777_fnAutoPathSize
    printf "${_fGreB}%s@%s'${_fN}:${_fCyaB}%s${_fN}\033[36m%s${_fCyaB}%s${_fN}" \
      "${ps1_u:0:4}" "${ps1_h:0:3}" \
      "$showWorkdirStart" "$showWorkdirMiddle" "$showWorkdir"
  fi

  # exitCode
  [ $exitCode -eq 0 ] || printf " ${_fRedB}(exit:$exitCode)${_fN}"

  # NOTE:
  # git 狀態:
  #   - 捨棄判斷是沒有 git 專案或 `git init` 的功能. 由
  #     `git status` 改為 `git symbolic-ref` 和 `git rev-parse`
  #     解決當未 commit 的文件數量過多時的耗時問題.
  #   - `git status --porcelain` 耗費時間和文件數量 (git status) 成正比
  PS777_fnGitStatus() {
    local curr_hash
    curr_hash=$(git rev-parse --short HEAD 2> /dev/null)
    [ $? -eq 0 ] || return

    local color curr_branch

    # `git symbolic-ref --short HEAD` 是
    # `git branch --show-current` (v2.22.0 才支持) 底層的方法.
    # 也可以使用 `git log --pretty=format:"%h" -1` 來代替.
    curr_branch=$(git symbolic-ref --short HEAD 2> /dev/null)
    [ $? -eq 0 ] || curr_branch="($curr_hash)"

    git status --porcelain | grep -qE '^\s?[AMDR]' &&
      color=$_fYelB || color=$_fCyaW

    printf " ${color}[git:$curr_branch]${_fN}"
  }
  PS777_fnGitStatus

  # 命令耗時
  if [ -n "$PS777_tmpVarCmdDuration" ]; then
    if [ "$PS777_tmpVarCmdDuration" -ge 60 ]; then
      printf " (spend: %dm %ds)" \
        $((PS777_tmpVarCmdDuration / 60)) \
        $((PS777_tmpVarCmdDuration % 60))
    elif [ "$PS777_tmpVarCmdDuration" -gt 2 ]; then
      printf " (spend:%ds)" $PS777_tmpVarCmdDuration
    fi
  fi

  # shell 層數
  [ "$SHLVL" -ge 2 ] &&
    printf "\\nL$SHLVL\$ " ||
    printf '\n$ '
}

PS777_fnCmdTimeit() {
  PS777_tmpVarCmdTimeit=${PS777_tmpVarCmdTimeit:-$SECONDS}
}

PS777_fnPromptCommand() {
  PS777_tmpVarCmdDuration=$(($SECONDS - $PS777_tmpVarCmdTimeit))
  unset PS777_tmpVarCmdTimeit
}

[ -n "$PS777_varIsStart" ] || {
  trap 'PS777_fnCmdTimeit' DEBUG
  PS777_varIsStart=1
}

PROMPT_COMMAND=PS777_fnPromptCommand

PS1=\
'`tmpExitCode=$?; type PS777 &> /dev/null'\
'   && PS777 "\u" "\h" "\w" "$tmpExitCode"'\
'   || echo "[\u@\h \W]\$ "`'
